# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string

# Leave unset locally to use SQLite in instance/. On Render, set to the Supabase session pooler URL.
# DATABASE_URL=

OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=

STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

NTFY_SERVER=https://ntfy.sh

# Demo only (local, single process): enables /api/demo/* and runs the clock 60x faster.
DEMO_MODE=0
DEMO_SPEED=1
