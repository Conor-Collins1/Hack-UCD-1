# Copy to .env locally. Never commit real credentials.
APP_ENV=development
SESSION_SECRET=replace-with-a-long-random-string
PUBLIC_URL=http://127.0.0.1:8000
# Leave blank for local SQLite; set to your hosted PostgreSQL URL online.
DATABASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
NTFY_SERVER=https://ntfy.sh
# Synthetic local replay only. Keep disabled online.
DEMO_MODE=0
DEMO_SPEED=1
